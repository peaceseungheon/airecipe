# 미니앱 환경변수 — 09-ENV-CONFIG §9.1.1 SSOT
# 모든 값은 빌드 시점 plugin-env로 주입되어 import.meta.env로 접근.
# API 키·시크릿은 미니앱에 절대 두지 않는다(09 §9.1.1 금지 항목).

# 백엔드 베이스 URL (현재 Next.js + Vercel — AIReceipe 저장소)
# local:      http://localhost:3000 (iOS sim) / http://10.0.2.2:3000 (Android emul)
# staging:    https://aireceipe-staging.vercel.app (예시 — 실제 운영 도메인으로 교체)
# production: https://aireceipe.example.com (예시 — 콘솔 등록 도메인으로 교체)
API_BASE_URL=http://localhost:3000

# 환경 구분 — "local" | "staging" | "production"
APP_ENV=local

# 로깅 레벨 — "info" | "debug" | "warn" | "error"
LOG_LEVEL=info

# (선택) Sentry DSN — 에러 트래킹 도입 시
# SENTRY_DSN=https://...@sentry.io/...
