# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# oh-my-claudecode session state (로컬 전용)
.omc/sessions/
.omc/state/

# 세션 audit trail (로컬 전용, 커밋 금지)
_workspace/
_workspace_*/

# Claude Code 런타임 잠금 파일
.claude/scheduled_tasks.lock
