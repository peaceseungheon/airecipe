# AIReceipe — 환경 변수 예시 (.env.local로 복사 후 값 채우기)
#
# 모든 비-NEXT_PUBLIC 변수는 서버 전용입니다.
# NEXT_PUBLIC_* 접두사는 브라우저 번들에 노출되므로 비밀키에는 절대 사용 금지.

# ----- Supabase -----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ----- AI Provider 선택 (ADR-008) -----
# "gemini" (기본) | "claude" (롤백용)
AI_PROVIDER=gemini

# ----- Gemini (기본 Provider) -----
# AI_PROVIDER=gemini일 때 필수
GEMINI_API_KEY=
# 선택: 모델 오버라이드 (기본 gemini-3.1-flash-lite)
# GEMINI_MODEL=gemini-3.1-flash-lite

# ----- Claude (롤백용 — AI_PROVIDER=claude일 때 필수) -----
# 운영 중 즉시 롤백하려면 AI_PROVIDER=claude로 변경 후 아래 키 활성화 + 재배포
# ANTHROPIC_API_KEY=
# 선택: 모델 오버라이드 (기본 claude-haiku-4-5-20251001)
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ----- 앱인토스 미니앱 CORS (ADR-010) -----
# 미니앱(앱인토스) origin 화이트리스트. 콤마 구분(공백 trim). 빈 값이면 모든 cross-origin 거부.
# 웹앱은 same-origin 이므로 본 변수와 무관.
# 예: APPSINTOSS_ALLOWED_ORIGINS=https://your-miniapp.toss.im,https://staging-miniapp.toss.im
APPSINTOSS_ALLOWED_ORIGINS=
