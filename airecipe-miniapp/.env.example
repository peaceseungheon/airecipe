# 미니앱 환경변수 (예시) — 09-ENV-CONFIG §9.1.1 SSOT
# 이 파일을 .env.local / .env.staging / .env.production으로 복사해 값 채움.
# build:staging / build:prod가 dotenv-cli(-e <파일>)로 로드 → ait build 자식의 process.env에
# 주입 → granite.config.ts의 env({...})가 읽어 import.meta.env로 인라인.
# (plugin-env 자체는 .env 파일을 읽지 않는다 — dotenv-cli가 process.env를 채워야 한다.)
# API 키·시크릿은 미니앱에 절대 두지 않는다(09 §9.1.1 금지 항목).

# 백엔드 베이스 URL (현재 Next.js + Vercel — AIReceipe 저장소)
# local:      http://localhost:3000 (iOS sim) / http://10.0.2.2:3000 (Android emul)
# staging:    https://aireceipe-staging.vercel.app (예시 — 실제 운영 도메인으로 교체)
# production: https://aireceipe.example.com (예시 — 콘솔 등록 도메인으로 교체)
API_BASE_URL=http://localhost:3000

# 환경 구분 — "local" | "staging" | "production"
APP_ENV=local

# 로깅 레벨 — "info" | "debug" | "warn" | "error"
LOG_LEVEL=info

# (선택) Sentry DSN — 런타임 에러 트래킹 (ADR-019). 공개 키.
# 미설정 또는 APP_ENV=local이면 Sentry.init 스킵.
# SENTRY_DSN=https://...@sentry.io/...

# Sentry 소스맵 업로드 — CI 전용(@granite-js/plugin-sentry, ADR-019).
# 아래 3개는 빌드 시점에만 사용되며 미니앱 번들에 포함되지 않는다.
# SENTRY_AUTH_TOKEN은 비공개 — 절대 커밋·번들에 두지 말 것. CI 시크릿으로만 주입.
# 토큰 미설정 시 plugin은 no-op(로컬/기여자 빌드 안전).
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=

ADS_ENABLED=true
ADS_INLINE_GROUP_ID=<콘솔에서 발급받은 인라인 배너 group id>
ADS_FULLSCREEN_GROUP_ID=<전면광고 쓸 거면, 아니면 생략>
